---
import { copy } from '../i18n';
import type { Lang } from '../i18n/types';
import { email, github, linkedin, newTab } from '../data/contact';

interface Props {
  lang: Lang;
}

const t = copy[Astro.props.lang];
---

<aside class="side">
  <a href={`mailto:${email}`} aria-label={t.labels.email}
    ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
      ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3.5 6.5 8.5 6.5 8.5-6.5"></path></svg
    ></a
  >
  <a href={github} aria-label={t.labels.github} {...newTab}
    ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
      ><path
        d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.46-1.1-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
      ></path></svg
    ></a
  >
  <a href={linkedin} aria-label={t.labels.linkedin} {...newTab}
    ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
      ><path
        d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.84v1.54h.05c.53-1 1.84-2.06 3.8-2.06 4.06 0 4.81 2.67 4.81 6.15V21h-4v-4.98c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.91 1.3-1.91 2.63V21h-4V9.75Z"
      ></path></svg
    ></a
  >
</aside>

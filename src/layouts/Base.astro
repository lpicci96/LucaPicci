---
import '../styles/global.css';
import serifFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import sansFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import { copy, homePath } from '../i18n';
import { langs, type Lang } from '../i18n/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const absolute = (path: string) => new URL(path, Astro.site).href;
const others = langs.filter((l) => l !== lang);

// Self-hosted, Latin subset only (as Fontsource declares it). The serif keeps its optical-size axis.
const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face { font-family: 'Source Serif 4 Variable'; font-style: normal; font-display: swap; font-weight: 200 900;
  src: url(${serifFont}) format('woff2-variations'); unicode-range: ${latin}; }
@font-face { font-family: 'Instrument Sans Variable'; font-style: normal; font-display: swap; font-weight: 400 700;
  src: url(${sansFont}) format('woff2-variations'); unicode-range: ${latin}; }`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={absolute(homePath[lang])} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={absolute(homePath[l])} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(homePath.en)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={absolute(homePath[lang])} />
    <meta property="og:image" content={absolute('/og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {others.map((l) => <meta property="og:locale:alternate" content={copy[l].meta.ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
  </head>
  <body>
    <slot />
  </body>
</html>
